#!/usr/bin/env bash
# gsm -- workspace tool for the Osmocom GSM submodule collection.
#
#   ./gsm init    [--source fork|mirror|gitea] [--recursive]   check out all submodules
#   ./gsm status                                              one-line state per component
#   ./gsm verify  [--build]                                    pins, history, compat, (build) checks
#   ./gsm doctor                                              check host build prerequisites
#   ./gsm build   [--check] [--jobs N] [component...]         configure/make/install in order
#   ./gsm env                                                 print env exports for _install/
#   ./gsm bump    <component> <tag|commit> [--push]           move one pin (staged, not committed)
#
# Every command prints [ OK ] / [WARN] / [FAIL] lines and exits non-zero if anything failed.

set -o pipefail
shopt -s extglob

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="$ROOT/components.conf"
GSM_PREFIX="${GSM_PREFIX:-$ROOT/_install}"
BUILD_DIR="${GSM_BUILD_DIR:-$ROOT/_build}"
GITEA_BASE="https://gitea.osmocom.org"
MIRROR_BASE="https://github.com/osmocom"
NET_TIMEOUT="${GSM_NET_TIMEOUT:-60}"

# ---------------------------------------------------------------- output helpers
if [[ -t 1 ]]; then C_OK=$'\e[32m'; C_WARN=$'\e[33m'; C_FAIL=$'\e[31m'; C_B=$'\e[1m'; C_0=$'\e[0m'
else C_OK=; C_WARN=; C_FAIL=; C_B=; C_0=; fi
FAILS=0; WARNS=0
ok()   { printf '%s[ OK ]%s %s\n' "$C_OK" "$C_0" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_WARN" "$C_0" "$*"; WARNS=$((WARNS+1)); }
fail() { printf '%s[FAIL]%s %s\n' "$C_FAIL" "$C_0" "$*"; FAILS=$((FAILS+1)); }
hint() { printf '       -> %s\n' "$*"; }
head1(){ printf '\n%s== %s%s\n' "$C_B" "$*" "$C_0"; }
die()  { printf '%s[FAIL]%s %s\n' "$C_FAIL" "$C_0" "$*" >&2; exit 2; }
summary() {
	echo
	if (( FAILS )); then printf '%sResult: %d failure(s), %d warning(s).%s\n' "$C_FAIL" "$FAILS" "$WARNS" "$C_0"; return 1
	elif (( WARNS )); then printf '%sResult: OK with %d warning(s).%s\n' "$C_WARN" "$WARNS" "$C_0"
	else printf '%sResult: OK.%s\n' "$C_OK" "$C_0"; fi
}

(( BASH_VERSINFO[0] >= 4 )) || die "bash >= 4 required (found $BASH_VERSION)"
command -v git >/dev/null || die "git not found"

# ---------------------------------------------------------------- manifest
NAMES=(); declare -A CPATH CTAG CUP
while read -r n p t u _; do
	[[ -z "$n" || "$n" == \#* ]] && continue
	NAMES+=("$n"); CPATH[$n]="$p"; CTAG[$n]="$t"; CUP[$n]="$u"
done < "$MANIFEST"
(( ${#NAMES[@]} )) || die "no components in $MANIFEST"

is_component() { [[ -n "${CPATH[$1]:-}" ]]; }
gitea_url()  { echo "$GITEA_BASE/${CUP[$1]}"; }
mirror_url() { echo "$MIRROR_BASE/$1"; }
fork_url()   { git -C "$ROOT" config -f .gitmodules "submodule.$1.url"; }
gitlink()    { git -C "$ROOT" ls-files -s -- "${CPATH[$1]}" | awk '$1=="160000"{print $2}'; }
checked_out(){ [[ -e "$ROOT/${CPATH[$1]}/.git" ]] && git -C "$ROOT/${CPATH[$1]}" rev-parse -q --verify HEAD >/dev/null 2>&1; }
is_sha()     { [[ "$1" =~ ^[0-9a-f]{7,40}$ ]]; }

# pkg-config module -> component that provides it
declare -A PROVIDER=(
	[libosmocore]=libosmocore [libosmogsm]=libosmocore [libosmovty]=libosmocore [libosmoctrl]=libosmocore
	[libosmocodec]=libosmocore [libosmocoding]=libosmocore [libosmogb]=libosmocore [libosmosim]=libosmocore
	[libosmousb]=libosmocore [libosmoisdn]=libosmocore
	[libosmo-netif]=libosmo-netif [libosmoabis]=libosmo-abis [libosmotrau]=libosmo-abis
	[libosmo-sigtran]=libosmo-sigtran [libosmo-mgcp-client]=osmo-mgw [libosmo-gsup-client]=osmo-hlr
)

load_build_conf() {
	declare -gA CONFIGURE_FLAGS=()
	# shellcheck source=config/build.conf
	source "$ROOT/config/build.conf"
	[[ -f "$ROOT/config/build.local.conf" ]] && source "$ROOT/config/build.local.conf"
	return 0
}

# ---------------------------------------------------------------- init
cmd_init() {
	local source=fork recursive=0
	while (( $# )); do case "$1" in
		--source) source="$2"; shift 2;;
		--source=*) source="${1#*=}"; shift;;
		--recursive) recursive=1; shift;;
		*) die "init: unknown option $1";; esac; done
	[[ "$source" =~ ^(fork|mirror|gitea)$ ]] || die "--source must be fork, mirror or gitea"

	head1 "Initialising ${#NAMES[@]} submodules (source: $source)"
	git -C "$ROOT" submodule sync -q
	git -C "$ROOT" submodule init -q

	local n url p
	for n in "${NAMES[@]}"; do
		p="${CPATH[$n]}"
		case "$source" in
			fork)   url="$(fork_url "$n")";;
			mirror) url="$(mirror_url "$n")";;
			gitea)  url="$(gitea_url "$n")";;
		esac
		# local, uncommitted override; .gitmodules (the forks) stays authoritative
		git -C "$ROOT" config "submodule.$n.url" "$url"
		checked_out "$n" && git -C "$ROOT/$p" remote set-url origin "$url"

		if ! timeout "$NET_TIMEOUT" git ls-remote -q --exit-code "$url" HEAD >/dev/null 2>&1; then
			fail "$n: cannot reach $url"
			[[ "$source" == fork ]] && hint "fork missing or private? run tools/create-forks.sh, or use: ./gsm init --source mirror"
			continue
		fi
		local out
		if ! out="$(git -C "$ROOT" submodule update --init -- "$p" 2>&1)"; then
			fail "$n: checkout of pinned commit $(gitlink "$n" | cut -c1-12) failed"
			printf '%s\n' "$out" | tail -n 4 | sed 's/^/       | /'
			grep -q -e 'not our ref' -e 'reference is not a tree' -e 'did not contain' <<<"$out" &&
				hint "the pinned commit is not in $url -- push its tag to the fork (see docs/UPSTREAM.md)"
			continue
		fi
		# helper remotes, never overwriting a remote the user already configured differently
		local rn ru
		for rn in upstream mirror; do
			[[ $rn == upstream ]] && ru="$(gitea_url "$n")" || ru="$(mirror_url "$n")"
			local cur; cur="$(git -C "$ROOT/$p" remote get-url "$rn" 2>/dev/null)"
			if [[ -z "$cur" ]]; then git -C "$ROOT/$p" remote add "$rn" "$ru"
			elif [[ "$cur" != "$ru" ]]; then warn "$n: remote '$rn' already points to $cur (left unchanged)"; fi
		done
		ok "$n  $(git -C "$ROOT/$p" describe --tags --always 2>/dev/null)  ($p)"
	done

	if (( recursive )) && checked_out osmo-trx; then
		head1 "Nested submodule: osmo-trx/osmocom-bb (only needed for --with-mstrx)"
		[[ "$source" != gitea ]] && git -C "$ROOT/${CPATH[osmo-trx]}" config submodule.osmocom-bb.url "$MIRROR_BASE/osmocom-bb"
		if git -C "$ROOT/${CPATH[osmo-trx]}" submodule update --init 2>&1 | tail -n 3; then ok "osmocom-bb checked out"
		else fail "osmocom-bb checkout failed"; fi
	fi
	summary || { hint "fix the failures above and re-run ./gsm init (it is idempotent)"; return 1; }
	echo "Next: ./gsm doctor && ./gsm build"
}

# ---------------------------------------------------------------- status
cmd_status() {
	printf '%-16s %-22s %-12s %-24s %s\n' COMPONENT PATH PINNED CHECKED-OUT ORIGIN
	local n p d dirty
	for n in "${NAMES[@]}"; do
		p="${CPATH[$n]}"
		if checked_out "$n"; then
			d="$(git -C "$ROOT/$p" describe --tags --always 2>/dev/null)"
			[[ "$(git -C "$ROOT/$p" rev-parse HEAD)" != "$(gitlink "$n")" ]] && d="$d (!= pin)"
			dirty="$(git -C "$ROOT/$p" status --porcelain --untracked-files=no | head -c1)"
			[[ -n "$dirty" ]] && d="$d*"
			printf '%-16s %-22s %-12s %-24s %s\n' "$n" "$p" "${CTAG[$n]}" "$d" "$(git -C "$ROOT/$p" remote get-url origin)"
		else
			printf '%-16s %-22s %-12s %-24s %s\n' "$n" "$p" "${CTAG[$n]}" "(not initialised)" "-"
		fi
	done
	echo "(* = modified tracked files; != pin = HEAD differs from the commit recorded in gsm)"
}

# ---------------------------------------------------------------- verify
version_of() { # release version a checked-out component claims (from git describe)
	git -C "$ROOT/${CPATH[$1]}" describe --tags --abbrev=0 --match '[0-9]*' 2>/dev/null
}
ver_ge() { [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" == "$2" ]]; }

cmd_verify() {
	local want_build=0; [[ "${1:-}" == --build ]] && want_build=1

	head1 "Manifest vs .gitmodules"
	local subs; subs="$(git -C "$ROOT" config -f .gitmodules --name-only --get-regexp '^submodule\..*\.path$' | sed 's/^submodule\.//; s/\.path$//' | sort)"
	if [[ "$subs" == "$(printf '%s\n' "${NAMES[@]}" | sort)" ]]; then ok "${#NAMES[@]} submodules, names match components.conf"
	else fail ".gitmodules and components.conf list different components"; diff <(echo "$subs") <(printf '%s\n' "${NAMES[@]}" | sort) | sed 's/^/       | /'; fi
	local n p
	for n in "${NAMES[@]}"; do
		p="${CPATH[$n]}"
		[[ "$(git -C "$ROOT" config -f .gitmodules "submodule.$n.path")" == "$p" ]] || fail "$n: path in .gitmodules differs from $p"
		[[ -n "$(gitlink "$n")" ]] || fail "$n: no gitlink recorded at $p"
	done

	head1 "Pinned commits and histories"
	for n in "${NAMES[@]}"; do
		p="${CPATH[$n]}"
		if ! checked_out "$n"; then fail "$n: not checked out"; hint "./gsm init"; continue; fi
		local g head want t="${CTAG[$n]}"
		g="$(gitlink "$n")"; head="$(git -C "$ROOT/$p" rev-parse HEAD)"
		if is_sha "$t"; then want="$(git -C "$ROOT/$p" rev-parse -q --verify "$t^{commit}")"
		else want="$(git -C "$ROOT/$p" rev-parse -q --verify "refs/tags/$t^{commit}")"; fi
		[[ -z "$want" ]] && { fail "$n: '$t' (components.conf) not found in local clone"; hint "git -C $p fetch --tags upstream"; continue; }
		[[ "$g" != "$want" ]] && { fail "$n: gitlink ${g:0:12} != $t (${want:0:12})"; continue; }
		[[ "$head" != "$g" ]] && { fail "$n: checked out ${head:0:12}, pin is ${g:0:12}"; hint "git submodule update -- $p"; continue; }
		if [[ "$(git -C "$ROOT/$p" rev-parse --is-shallow-repository)" == true ]]; then
			warn "$n: shallow clone, history incomplete"
		fi
		local commits lic dirty
		commits="$(git -C "$ROOT/$p" rev-list --count HEAD)"
		lic="$(cd "$ROOT/$p" && ls COPYING* LICENSE* 2>/dev/null | head -1)"
		dirty="$(git -C "$ROOT/$p" status --porcelain --untracked-files=no)"
		[[ -z "$lic" ]] && warn "$n: no COPYING/LICENSE file at top level"
		[[ -n "$dirty" ]] && warn "$n: tracked files modified"
		ok "$n  $t = ${g:0:12}  ($commits commits, ${lic:-no licence file})"
	done

	head1 "Inter-component version requirements (configure.ac PKG_CHECK_MODULES)"
	for n in "${NAMES[@]}"; do
		checked_out "$n" || continue
		local line mod op need prov have bad=0 seen=0
		while read -r mod op need; do
			prov="${PROVIDER[$mod]:-}"; [[ -z "$prov" ]] && continue
			seen=$((seen+1))
			have="$(version_of "$prov")"
			if ! is_component "$prov" || [[ -z "$have" ]]; then fail "$n needs $mod $op $need but $prov version unknown"; bad=1
			elif ! ver_ge "$have" "$need"; then fail "$n needs $mod >= $need, but $prov is $have"; bad=1; fi
		done < <(sed -n 's/.*PKG_CHECK_MODULES([^,]*, *\[\{0,1\}\([a-z0-9-]*\) *\(>=\) *\([0-9.]*\).*/\1 \2 \3/p' "$ROOT/${CPATH[$n]}/configure.ac")
		(( bad )) || ok "$n: $seen Osmocom library requirement(s) satisfied"
	done

	head1 "Build products in ${GSM_PREFIX/#$ROOT\//}"
	local -a bins=(osmo-stp osmo-mgw osmo-hlr osmo-msc osmo-bsc osmo-bts-virtual osmo-bts-trx)
	local b found=0 missing=()
	for b in "${bins[@]}"; do [[ -x "$GSM_PREFIX/bin/$b" ]] && found=$((found+1)) || missing+=("$b"); done
	local trx; trx="$(ls "$GSM_PREFIX"/bin/osmo-trx-* 2>/dev/null | xargs -rn1 basename | tr '\n' ' ')"
	if (( found == ${#bins[@]} )) && [[ -n "$trx" ]]; then ok "all network element binaries present (+ $trx)"
	elif (( want_build )); then fail "missing: ${missing[*]} ${trx:+}${trx:-osmo-trx-*}"; hint "./gsm build"
	else warn "not built yet or incomplete (missing: ${missing[*]}${trx:+}${trx:- osmo-trx-*}) -- informational; use --build to enforce"; fi

	echo
	echo "Note: this verifies source pins, history and build compatibility. It does NOT show that a"
	echo "GSM network works -- see docs/NETWORK.md for what a running network additionally needs."
	summary
}

# ---------------------------------------------------------------- doctor / build
export_env() {
	export PKG_CONFIG_PATH="$GSM_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
	export LD_LIBRARY_PATH="$GSM_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
	export PATH="$GSM_PREFIX/bin:$PATH"
}

cmd_doctor() {
	head1 "Host tools"
	local t
	for t in gcc g++ make autoreconf libtoolize pkg-config; do
		command -v "$t" >/dev/null && ok "$t" || fail "$t not found"
	done
	command -v autoreconf >/dev/null || hint "Debian/Ubuntu: apt install build-essential autoconf automake libtool pkg-config"
	head1 "Only needed for unit tests (./gsm build --check)"
	command -v sqlite3 >/dev/null && ok "sqlite3 CLI" || warn "sqlite3 CLI missing: osmo-hlr db_upgrade test will fail (apt install sqlite3)"
	command -v python3 >/dev/null && ok "python3" || warn "python3 missing: tests/smoke-core.sh needs it"
	if [[ -e /proc/net/if_inet6 ]]; then ok "IPv6 available"
	else warn "no IPv6 on this host: libosmocore 'socket' and osmo-mgw 'mgcp_client' tests need ::1"; fi
	head1 "System libraries (pkg-config)"
	export_env; load_build_conf
	local -A req=([talloc]="libtalloc-dev" [libsctp]="libsctp-dev" [sqlite3]="libsqlite3-dev")
	local m
	for m in talloc libsctp sqlite3; do
		pkg-config --exists "$m" && ok "$m $(pkg-config --modversion "$m")" || { fail "$m missing"; hint "apt install ${req[$m]}"; }
	done
	# optional libraries whose need depends on configure flags
	check_opt() { # component flag-regex(enabled-if-NOT-disabled|enabled) module pkg
		local comp="$1" disable="$2" mod="$3" pkg="$4" flags="${CONFIGURE_FLAGS[$1]}"
		[[ "$flags" =~ $disable ]] && { ok "$mod not needed ($comp: ${BASH_REMATCH[0]})"; return; }
		pkg-config --exists "$mod" && ok "$mod $(pkg-config --modversion "$mod") (for $comp)" ||
			{ fail "$mod missing (needed by $comp with current flags)"; hint "apt install $pkg, or set a --disable flag in config/build.local.conf"; }
	}
	check_opt libosmocore '--disable-gnutls' gnutls libgnutls28-dev
	check_opt libosmocore '--disable-libmnl' libmnl libmnl-dev
	check_opt libosmocore '--disable-pcsc' libpcsclite libpcsclite-dev
	check_opt libosmocore '--disable-libusb' libusb-1.0 libusb-1.0-0-dev
	check_opt libosmocore '--disable-uring' liburing liburing-dev
	check_opt libosmo-abis '--disable-ortp' ortp libortp-dev
	check_opt osmo-bts '--disable-ortp' ortp libortp-dev
	local trxf="${CONFIGURE_FLAGS[osmo-trx]}"
	[[ "$trxf" == *--with-uhd* ]]     && { pkg-config --exists uhd && ok "uhd (osmo-trx)" || { fail "uhd missing (osmo-trx --with-uhd)"; hint "apt install libuhd-dev uhd-host, or choose another driver in config/build.local.conf"; }; }
	[[ "$trxf" == *--with-lms* ]]     && { pkg-config --exists LimeSuite && ok "LimeSuite (osmo-trx)" || { fail "LimeSuite missing"; hint "apt install limesuite-dev"; }; }
	[[ "$trxf" == *--with-bladerf* ]] && { pkg-config --exists libbladeRF && ok "libbladeRF (osmo-trx)" || { fail "libbladeRF missing"; hint "apt install libbladerf-dev"; }; }
	[[ "$trxf" == *--disable-multi-arfcn* ]] && ok "fftw3f not needed (osmo-trx: --disable-multi-arfcn)" ||
		{ pkg-config --exists fftw3f && ok "fftw3f (osmo-trx multi-ARFCN)" || { fail "fftw3f missing (osmo-trx multi-ARFCN)"; hint "apt install libfftw3-dev, or add --disable-multi-arfcn"; }; }
	summary
}

build_one() {
	local n="$1" jobs="$2" check="$3"
	local src="$ROOT/${CPATH[$n]}" bld="$BUILD_DIR/$n" log="$BUILD_DIR/logs/$n.log"
	mkdir -p "$bld" "$BUILD_DIR/logs"; : > "$log"
	checked_out "$n" || { fail "$n: not checked out (./gsm init)"; return 1; }
	local flags="${CONFIGURE_FLAGS[$n]:-}" step
	printf '       %s: configure %s\n' "$n" "${flags:-(defaults)}"
	run() { step="$1"; shift; echo "### $step: $*" >>"$log"; "$@" >>"$log" 2>&1; }
	# shellcheck disable=SC2086
	if run autoreconf bash -c "cd '$src' && autoreconf -fi" &&
	   run configure bash -c "cd '$bld' && '$src/configure' --prefix='$GSM_PREFIX' $flags" &&
	   run make make -C "$bld" -j"$jobs" &&
	   { (( ! check )) || run check make -C "$bld" -j"$jobs" check; } &&
	   run install make -C "$bld" install; then
		ok "$n built and installed ($(git -C "$src" describe --tags --always))"
	else
		fail "$n: '$step' step failed -- full log: ${log#$ROOT/}"
		grep -n -m5 -i -E 'error|not found|No package' "$log" | tail -n 5 | sed 's/^/       | /'
		echo "       | ... last lines:"; tail -n 8 "$log" | sed 's/^/       | /'
		if [[ "$step" == check ]]; then   # autotest keeps a per-test log only for failed tests
			find "$bld" -path '*testsuite.dir/*/testsuite.log' 2>/dev/null | head -5 | while read -r f; do
				printf '       | failed: %s  (%s)\n' "$(sed -n '2s/^[0-9]*\. *[^ ]*: *testing *//p' "$f" | sed 's/ *\.\.\.$//')" "${f#$ROOT/}"; done
			find "$bld" -name 'test-suite.log' -size +1k 2>/dev/null | head -3 | sed "s|^$ROOT/||; s/^/       | see /"
		fi
		return 1
	fi
}

cmd_build() {
	local jobs; jobs="$(nproc 2>/dev/null || echo 2)"; local check=0 sel=()
	while (( $# )); do case "$1" in
		--jobs|-j) jobs="$2"; shift 2;; --jobs=*) jobs="${1#*=}"; shift;;
		--check) check=1; shift;;
		-*) die "build: unknown option $1";;
		*) is_component "$1" || die "unknown component: $1 (see components.conf)"; sel+=("$1"); shift;; esac; done
	(( ${#sel[@]} )) || sel=("${NAMES[@]}")
	load_build_conf; export_env
	head1 "Building into ${GSM_PREFIX} (order: components.conf)"
	local n s
	for n in "${NAMES[@]}"; do            # keep manifest order even for a subset
		for s in "${sel[@]}"; do [[ "$s" == "$n" ]] || continue
			if ! build_one "$n" "$jobs" "$check"; then
				hint "components after $n were not built (they may depend on it); fix and re-run: ./gsm build $n ..."
				summary; return 1
			fi
		done
	done
	summary && echo "Next: ./gsm verify --build ; eval \"\$(./gsm env)\""
}

cmd_env() {
	echo "export PKG_CONFIG_PATH=\"$GSM_PREFIX/lib/pkgconfig\${PKG_CONFIG_PATH:+:\$PKG_CONFIG_PATH}\""
	echo "export LD_LIBRARY_PATH=\"$GSM_PREFIX/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}\""
	echo "export PATH=\"$GSM_PREFIX/bin:\$PATH\""
}

# ---------------------------------------------------------------- bump
cmd_bump() {
	local n="${1:-}" ref="${2:-}" push=0; [[ "${3:-}" == --push ]] && push=1
	[[ -n "$n" && -n "$ref" ]] || die "usage: ./gsm bump <component> <tag|commit> [--push]"
	is_component "$n" || die "unknown component: $n"
	checked_out "$n" || die "$n not checked out"
	local p="$ROOT/${CPATH[$n]}"
	[[ -z "$(git -C "$p" status --porcelain --untracked-files=no)" ]] || die "$n has local modifications; commit or stash them first"

	head1 "Bumping $n to $ref"
	local r fetched=
	for r in upstream mirror; do
		git -C "$p" remote get-url "$r" >/dev/null 2>&1 || continue
		if timeout "$NET_TIMEOUT" git -C "$p" fetch -q --tags "$r" 2>/dev/null; then fetched=$r; break; fi
		warn "fetch from '$r' failed, trying next"
	done
	[[ -n "$fetched" ]] && ok "fetched from $fetched" || { fail "could not fetch from upstream or mirror"; summary; return 1; }
	local sha; sha="$(git -C "$p" rev-parse -q --verify "$ref^{commit}")" || { fail "$ref not found"; summary; return 1; }

	# the fork must contain the commit, or fresh clones of gsm will fail
	timeout "$NET_TIMEOUT" git -C "$p" fetch -q origin 2>/dev/null
	local in_fork=0
	if ! is_sha "$ref" && [[ "$(git -C "$p" ls-remote origin "refs/tags/$ref^{}" | cut -f1)" == "$sha" ||
	                        "$(git -C "$p" ls-remote origin "refs/tags/$ref" | cut -f1)" == "$sha" ]]; then in_fork=1
	elif git -C "$p" branch -r --contains "$sha" 2>/dev/null | grep -q '^ *origin/'; then in_fork=1; fi
	if (( ! in_fork )); then
		if (( push )) && ! is_sha "$ref"; then
			git -C "$p" push origin "refs/tags/$ref" && ok "pushed tag $ref to $(git -C "$p" remote get-url origin)" ||
				{ fail "push to fork failed"; summary; return 1; }
		else
			fail "$ref (${sha:0:12}) is not present in the fork $(git -C "$p" remote get-url origin)"
			hint "git -C ${CPATH[$n]} push origin refs/tags/$ref   (or re-run with --push)"
			summary; return 1
		fi
	fi
	git -C "$p" checkout -q "$sha" || { fail "checkout failed"; summary; return 1; }
	sed -i -E "s|^($n[[:space:]]+[^[:space:]]+[[:space:]]+)[^[:space:]]+|\1$ref|" "$MANIFEST"
	git -C "$ROOT" add -- "${CPATH[$n]}" components.conf
	ok "$n -> $ref (${sha:0:12}) staged"
	echo "Review: ./gsm verify   (checks the new version's library requirements against the other pins)"
	echo "Then:   git commit -m \"bump $n to $ref\""
}

# ---------------------------------------------------------------- dispatch
cmd="${1:-help}"; shift || true
case "$cmd" in
	init) cmd_init "$@";; status) cmd_status;; verify) cmd_verify "$@";;
	doctor) cmd_doctor;; build) cmd_build "$@";; env) cmd_env;; bump) cmd_bump "$@";;
	help|-h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//';;
	*) die "unknown command '$cmd' (try ./gsm help)";;
esac
